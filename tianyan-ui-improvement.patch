+/* ============ 思考链 + 工具调用 (卡片式设计, 不可复制, 可折叠) ============ */
+.think-chain{margin:8px 0 6px;user-select:none;-webkit-user-select:none;
+  display:flex;flex-direction:column;gap:6px}
+/* 思考块: 卡片式, 圆角, 微投影 */
+.think-block{position:relative;padding:8px 12px 8px 14px;
+  border-radius:var(--radius);cursor:pointer;transition:all .2s ease;
+  border:1px solid transparent;background:transparent}
+.think-block:hover{background:rgba(46,31,21,.02);border-color:var(--border)}
+/* 思考块类型色条 (左侧 3px 渐变) */
+.think-block::before{content:"";position:absolute;left:0;top:6px;bottom:6px;
+  width:3px;border-radius:2px;transition:all .2s}
+.think-block.tb-think::before{background:linear-gradient(180deg,var(--blue),var(--blue-soft))}
+.think-block.tb-tool::before{background:linear-gradient(180deg,var(--yellow),#c4960f)}
+.think-block.tb-done::before{background:linear-gradient(180deg,var(--green),#7aa85a)}
+.think-block.tb-reject::before{background:linear-gradient(180deg,var(--red),#c45a5a)}
+.think-block.tb-streaming::before{background:linear-gradient(180deg,var(--blue),var(--blue-soft));
+  animation:barPulse 1.5s ease-in-out infinite}
+@keyframes barPulse{0%,100%{opacity:1}50%{opacity:.4}}
