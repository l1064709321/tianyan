# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.venv/
venv/
env/

# 运行时数据与配置 (含密钥,不上传)
config.yaml
# .env 文件含真实 API Key, 绝对不上传 (.env.example 是模板可以上传)
.env
# data/ 屏蔽根目录运行时数据,但保留 app/data (技能语料库 + skills_core.py 内核,必须上传)
/data/
/*.db
/*.sqlite
/*.sqlite3
*.db
*.sqlite
*.sqlite3

# 日志
*.log
/tmp/
.novel-agent/

# 系统
.DS_Store
Thumbs.db
.idea/
.vscode/

# 本地开发产物 (不上传)
.python-version
screenshots/

# Playwright 浏览器内核 (不推荐装项目内: 平台二进制跨机不通用)
# 内核装各平台系统目录, 首次使用跑: ./setup_browser.sh (Linux/macOS) 或 setup_browser.bat (Windows)
.browsers/
