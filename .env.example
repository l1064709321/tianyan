# ============================================================
# 天衍 - 环境变量配置模板
# ============================================================
# 使用方法:
#   1. cp .env.example .env
#   2. 在 .env 里填入你自己的 API Key
#   3. docker-compose up -d
#
# 注意: .env 文件含真实密钥, 已被 .gitignore 排除, 不会被上传到 Git
# ============================================================

# ========== DeepSeek 默认配置 (推荐, 国内直连, 无需代理) ==========
OPENAI_API_KEY=sk-你的DeepSeek密钥
OPENAI_API_BASE=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# ========== 自定义模型 (优先级更高, 覆盖上面的默认配置) ==========
# 如果用第三方 OpenAI 兼容 API, 填这里
CUSTOM_API_KEY=
CUSTOM_API_BASE=
CUSTOM_MODEL_NAME=

# ========== 其他模型 API Key (按需配置) ==========
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DASHSCOPE_API_KEY=
ZAI_API_KEY=
MOONSHOT_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
VOLCENGINE_API_KEY=

# ========== 沙箱配置 (代码执行隔离) ==========
SANDBOX_ENABLED=true
SANDBOX_TIMEOUT=30

# ========== 记忆系统 (多项目隔离) ==========
# docker-compose 会自动配置这些, 本地开发可手动填
MEMORY_ENABLED=true
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://tianyan:tianyan123@localhost:5432/tianyan
CHROMA_PATH=./data/chroma
DATA_DIR=./data

# ========== 可选: HTTP 代理 (国内访问 OpenAI/Gemini/Anthropic 需要) ==========
# 留空 = 直连
# 填 http://127.0.0.1:7890 = 走本地代理 (Clash/V2Ray)
# Docker 容器内访问宿主机代理用 http://host.docker.internal:7890
PROXY=

# ========== 通用 ==========
TIMEOUT_SECONDS=600
LOG_LEVEL=info
